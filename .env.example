# PostgreSQL Connection Settings
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arandu_db

# LLM Provider Configuration (OpenAI or compatible API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# JWT Secret Key for API Authentication
JWT_SECRET=super_secret_key_change_me_in_production
JWT_ALGORITHM=HS256

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_channel_or_group_id_here


